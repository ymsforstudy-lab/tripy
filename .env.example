# 로컬 실행에 필요한 환경 변수 목록.
# 이 파일을 복사해 .env.local을 만들고 값을 채운다:  cp .env.example .env.local
# .env.local은 git에 올라가지 않는다. 실제 키를 이 파일에 쓰지 말 것.

# [필수] Supabase 대시보드 → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# [필수] 같은 화면의 anon public key (service_role 키 아님)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [선택] 로그인(OAuth) 후 돌아올 사이트 주소. 비우면 현재 접속 주소를 쓴다.
# 프로덕션 Vercel에는 실제 도메인으로 설정되어 있어야 한다.
NEXT_PUBLIC_SITE_URL=

# NEXT_PUBLIC_VERCEL_URL은 Vercel이 배포 시 자동으로 넣는다. 로컬에서는 설정하지 않는다.
